{
	"name": "@relayapi/db",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"baseline:rebuild": "bun run scripts/rebuild-baseline.ts",
		"baseline:rebuild:dry-run": "bun run scripts/rebuild-baseline.ts --dry-run",
		"baseline:rebuild:check": "bun run scripts/rebuild-baseline.ts --check",
		"baseline:sealed:check": "bun run scripts/verify-baseline-sealed.ts",
		"test:baseline-builder": "bun test scripts/rebuild-baseline.test.ts",
		"test:migration-contracts": "bun test scripts/migration-history-contract.test.ts scripts/migration-policy-contract.test.ts",
		"generate": "drizzle-kit generate",
		"studio": "drizzle-kit studio",
		"render:baseline-preamble-sql": "bun run scripts/render-baseline-preamble-sql.ts",
		"render:custom-migration-sql": "bun run scripts/render-custom-migration-sql.ts",
		"migrate": "bun run migration:manifest:check && bun run migration:policy:check && bun run migration:history && bun run scripts/migrate.ts",
		"verify:schema-contracts": "bun run scripts/verify-schema-contracts.ts",
		"test:schema-invariants": "bun test src/schema-invariant-audit.test.ts",
		"verify:migrations": "bun run scripts/verify-migrations.ts",
		"migration:policy:check": "bun run scripts/verify-migration-policy.ts",
		"migration:append-only": "bun run scripts/verify-migration-append-only.ts",
		"migration:manifest:write": "bun run scripts/verify-migration-history.ts --write-manifest",
		"migration:manifest:check": "bun run scripts/verify-migration-history.ts",
		"migration:history": "bun run scripts/verify-migration-history.ts --live",
		"migration:history:current": "bun run scripts/verify-migration-history.ts --live --require-current"
	},
	"dependencies": {
		"drizzle-orm": "catalog:",
		"postgres": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"drizzle-kit": "catalog:",
		"typescript": "catalog:"
	}
}
