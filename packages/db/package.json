{
	"name": "@relayapi/db",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"baseline:rebuild": "bun run scripts/rebuild-baseline.ts",
		"baseline:rebuild:dry-run": "bun run scripts/rebuild-baseline.ts --dry-run",
		"baseline:rebuild:check": "bun run scripts/rebuild-baseline.ts --check",
		"baseline:candidate:replay": "bun run scripts/replay-baseline-candidate.ts",
		"baseline:sealed:check": "bun run scripts/verify-baseline-sealed.ts",
		"migration:generation:check": "bun run scripts/verify-baseline-sealed.ts",
		"test:baseline-builder": "bun test scripts/rebuild-baseline.test.ts",
		"test:migration-contracts": "bun test scripts/*.test.ts",
		"generate": "drizzle-kit generate",
		"studio": "drizzle-kit studio",
		"render:baseline-preamble-sql": "bun run scripts/render-baseline-preamble-sql.ts",
		"render:custom-migration-sql": "bun run scripts/render-custom-migration-sql.ts",
		"migrate": "bun run migration:generation:check && bun run migration:manifest:check && bun run migration:policy:check && bun run migration:history && bun run scripts/migrate.ts",
		"verify:schema-contracts": "bun run scripts/verify-schema-contracts.ts",
		"test:schema-invariants": "bun test src",
		"verify:migrations": "bun run scripts/verify-migrations.ts",
		"migration:policy:check": "bun run scripts/verify-migration-policy.ts",
		"migration:source-ownership": "bun run scripts/verify-migration-source-ownership.ts",
		"migration:append-only": "bun run scripts/verify-migration-append-only.ts",
		"migration:manifest:write": "bun run scripts/verify-migration-history.ts --write-manifest",
		"migration:manifest:check": "bun run scripts/verify-migration-history.ts",
		"migration:history": "bun run scripts/verify-migration-history.ts --live",
		"migration:history:current": "bun run scripts/verify-migration-history.ts --live --require-current",
		"prelive:reset": "bun run scripts/prelive-reset.ts",
		"prelive:inventory": "bun run scripts/prelive-database-inventory.ts",
		"catalog:fingerprint:capture": "bun run scripts/capture-catalog-fingerprint.ts",
		"catalog:fingerprint:verify-active": "bun run scripts/verify-active-catalog-fingerprint.ts",
		"catalog:fingerprint:compare": "bun run scripts/compare-catalog-fingerprints.ts"
	},
	"dependencies": {
		"@relayapi/config": "workspace:*",
		"drizzle-orm": "catalog:",
		"postgres": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"drizzle-kit": "catalog:",
		"typescript": "catalog:"
	}
}
