{
	"name": "@relayapi/mcp-server",
	"version": "0.1.0",
	"description": "Model Context Protocol server exposing the RelayAPI automations API to AI agents",
	"author": "Relay <support@relayapi.dev>",
	"license": "Apache-2.0",
	"type": "module",
	"bin": {
		"relayapi-mcp-server": "dist/index.js"
	},
	"engines": {
		"node": ">=18"
	},
	"files": [
		"dist/**"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "bun run build",
		"test": "bun test",
		"test:package": "bun run build && node tests/package-smoke.mjs",
		"typecheck": "tsc --noEmit",
		"start": "bun src/index.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@relayapi/sdk": "^0.23.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"@types/node": "^26.1.1"
	}
}
