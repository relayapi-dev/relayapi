{
	"version": "0.2.0",
	"configurations": [
		{
			"command": "bun run dev:api",
			"name": "API (command-scoped DB tunnel)",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}",
			"internalConsoleOptions": "neverOpen"
		},
		{
			"command": "bun run dev:app",
			"name": "app-server",
			"request": "launch",
			"type": "node-terminal",
			"cwd": "${workspaceFolder}",
			"internalConsoleOptions": "neverOpen",
			"preLaunchTask": "caddy-proxy"
		},
		{
			"name": "workerd",
			"type": "node",
			"request": "attach",
			"websocketAddress": "ws://127.0.0.1:9230/core:user:relayapi-app",
			"cwd": "${workspaceFolder}/apps/app",
			"attachExistingChildren": false,
			"autoAttachChildProcesses": false,
			"restart": true,
			"resolveSourceMapLocations": [
				"${workspaceFolder}/apps/app/**",
				"${workspaceFolder}/packages/**",
				"!**/node_modules/**"
			],
			"skipFiles": ["<node_internals>/**", "**/node_modules/**"]
		},
		{
			"type": "chrome",
			"request": "launch",
			"name": "app-client",
			"url": "https://dev.relayapi.dev",
			"webRoot": "${workspaceFolder}/apps/app/src",
			"sourceMapPathOverrides": {
				"vite:///src/*": "${workspaceFolder}/apps/app/src/*",
				"vite:///*": "${workspaceFolder}/apps/app/*",
				"/@fs/*": "/*"
			},
			"skipFiles": ["**/node_modules/**"]
		}
	],
	"compounds": [
		{
			"name": "Debug App",
			"configurations": ["app-server", "workerd", "app-client"],
			"stopAll": true
		}
	]
}
