{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "relayapi",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-18",
	// Route same-zone global fetches through Cloudflare's public front door so
	// they cannot bypass Worker routes or zone security controls by reaching the
	// origin directly. This also prevents the same-zone origin bypass.
	// Docs: https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"vars": {
		// Emit Server-Timing headers + structured per-request timing logs (lib/perf.ts).
		// Disabled by default in production now that the performance audit is complete —
		// the always-on Server-Timing header leaked internal middleware names/timings and
		// SQL prefixes to every client, and 100%-sampled per-request logs scaled Workers
		// Logs billing with traffic. Re-enable ad hoc when profiling, e.g.
		// `wrangler deploy --var PERF_LOGS:1`.
		"PERF_LOGS": "0",
		// Non-secret source identity used to reject spoofed/misrouted R2 events.
		"R2_EVENT_ACCOUNT_ID": "3496f40fcd55a91da50ded8abea2cf7a",
		"R2_MEDIA_BUCKET_NAME": "relayapi-media"
	},
	// Minify the bundle — without this the worker ships ~8 MB unminified JS,
	// which inflates cold-start parse time.
	"minify": true,
	// Smart Placement: every handler is DB-bound against a single origin
	// (Hyperdrive -> db.relayapi.dev), so running the worker near the DB
	// instead of at the requester's edge cuts each query round trip.
	// Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/
	"placement": { "mode": "smart" },
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 0.1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false,
			"persist": false,
			"head_sampling_rate": 0.01
		}
	},
	"ai": {
		"binding": "AI"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "REALTIME",
				"class_name": "RealtimeDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["RealtimeDO"]
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "c4e14913be2b41628ef71ae12561f7e8"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "relayapi-media"
		},
		{
			// Durable social-account avatars. Separate from relayapi-media so its
			// finite lifecycle never removes connection profile pictures.
			"binding": "AVATAR_BUCKET",
			"bucket_name": "relayapi-avatars"
		},
		{
			// Durable, hyper-optimized post previews. Separate bucket so the
			// ~30-day lifecycle rule on relayapi-media never deletes thumbnails.
			// Serve publicly via a custom domain (thumbs.relayapi.dev) for
			// permanently CDN-cacheable preview URLs.
			"binding": "THUMBNAIL_BUCKET",
			"bucket_name": "relayapi-media-thumbnails"
		},
		{
			// Private terminal queue ledger with a required 30-day lifecycle. Tenant-
			// scoped objects are also removed immediately by organization deletion.
			"binding": "QUEUE_RESCUE_BUCKET",
			"bucket_name": "relayapi-queue-rescue-ledger"
		}
	],
	// Resize/encode tiny image thumbnails directly from R2 bytes (no public URL needed).
	// Docs: https://developers.cloudflare.com/images/optimization/binding/
	"images": {
		"binding": "IMAGES"
	},
	// Extract a still poster frame from video originals stored in R2.
	// Docs: https://developers.cloudflare.com/stream/transform-videos/bindings/
	"media": {
		"binding": "MEDIA"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "11180e4939824902a75753084dc6a8e9"
		}
	],
	"triggers": {
		"crons": [
			"*/1 * * * *",
			"*/5 * * * *",
			"*/30 * * * *",
			"0 0 1 * *",
			"0 9 * * *",
			"0 9 * * 1"
		]
	},
	"ratelimits": [
		{
			"name": "FREE_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 100,
				"period": 60
			}
		},
		{
			"name": "PRO_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": {
				"limit": 1000,
				"period": 60
			}
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "PUBLISH_QUEUE",
				"queue": "relayapi-publish"
			},
			{
				"binding": "EMAIL_QUEUE",
				"queue": "relayapi-email"
			},
			{
				"binding": "REFRESH_QUEUE",
				"queue": "relayapi-refresh"
			},
			{
				"binding": "INBOX_QUEUE",
				"queue": "relayapi-inbox"
			},
			{
				"binding": "TOOLS_QUEUE",
				"queue": "relayapi-tools"
			},
			{
				"binding": "ADS_QUEUE",
				"queue": "relayapi-ads"
			},
			{
				"binding": "SYNC_QUEUE",
				"queue": "relayapi-sync"
			},
			{
				"binding": "CUSTOMER_WEBHOOK_QUEUE",
				"queue": "relayapi-customer-webhooks"
			},
			{
				"binding": "QUEUE_RESCUE_QUEUE",
				"queue": "relayapi-queue-rescue"
			}
		],
		"consumers": [
			{
				"queue": "relayapi-media-cleanup",
				"max_batch_size": 10,
				"max_retries": 3,
				"dead_letter_queue": "relayapi-media-cleanup-dlq"
			},
			{
				"queue": "relayapi-publish",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_retries": 3,
				"dead_letter_queue": "relayapi-publish-dlq"
			},
			{
				"queue": "relayapi-email",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_concurrency": 1,
				"max_retries": 5,
				"dead_letter_queue": "relayapi-email-dlq"
			},
			{
				"queue": "relayapi-refresh",
				"max_batch_size": 10,
				"max_retries": 3,
				"max_concurrency": 5,
				"dead_letter_queue": "relayapi-refresh-dlq"
			},
			{
				"queue": "relayapi-inbox",
				"max_batch_size": 10,
				"max_retries": 5,
				"max_concurrency": 5,
				"dead_letter_queue": "relayapi-inbox-dlq"
			},
			{
				"queue": "relayapi-tools",
				"max_batch_size": 5,
				"max_retries": 3,
				"max_concurrency": 3,
				"dead_letter_queue": "relayapi-tools-dlq"
			},
			{
				"queue": "relayapi-ads",
				"max_batch_size": 5,
				"max_retries": 3,
				"max_concurrency": 3,
				"dead_letter_queue": "relayapi-ads-dlq"
			},
			{
				"queue": "relayapi-sync",
				"max_batch_size": 5,
				"max_retries": 3,
				"max_concurrency": 5,
				"dead_letter_queue": "relayapi-sync-dlq"
			},
			{
				"queue": "relayapi-customer-webhooks",
				"max_batch_size": 10,
				"max_retries": 5,
				"max_concurrency": 5,
				"dead_letter_queue": "relayapi-customer-webhooks-dlq"
			},
			{
				"queue": "relayapi-media-cleanup-dlq",
				"max_batch_size": 10,
				"max_retries": 3,
				"max_concurrency": 1,
				"dead_letter_queue": "relayapi-queue-rescue"
			},
			{
				"queue": "relayapi-publish-dlq",
				"max_batch_size": 10,
				"max_retries": 3,
				"max_concurrency": 1,
				"dead_letter_queue": "relayapi-queue-rescue"
			},
			{
				"queue": "relayapi-email-dlq",
				"max_batch_size": 10,
				"max_retries": 3,
				"max_concurrency": 1,
				"dead_letter_queue": "relayapi-queue-rescue"
			},
			{
				"queue": "relayapi-refresh-dlq",
				"max_batch_size": 10,
				"max_retries": 3,
				"max_concurrency": 1,
				"dead_letter_queue": "relayapi-queue-rescue"
			},
			{
				"queue": "relayapi-inbox-dlq",
				"max_batch_size": 10,
				"max_retries": 3,
				"max_concurrency": 1,
				"dead_letter_queue": "relayapi-queue-rescue"
			},
			{
				"queue": "relayapi-tools-dlq",
				"max_batch_size": 10,
				"max_retries": 3,
				"max_concurrency": 1,
				"dead_letter_queue": "relayapi-queue-rescue"
			},
			{
				"queue": "relayapi-ads-dlq",
				"max_batch_size": 10,
				"max_retries": 3,
				"max_concurrency": 1,
				"dead_letter_queue": "relayapi-queue-rescue"
			},
			{
				"queue": "relayapi-sync-dlq",
				"max_batch_size": 10,
				"max_retries": 3,
				"max_concurrency": 1,
				"dead_letter_queue": "relayapi-queue-rescue"
			},
			{
				"queue": "relayapi-customer-webhooks-dlq",
				"max_batch_size": 10,
				"max_retries": 3,
				"max_concurrency": 1,
				"dead_letter_queue": "relayapi-queue-rescue"
			},
			{
				"queue": "relayapi-queue-rescue",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 100,
				"max_concurrency": 2
			}
		]
	}
}
