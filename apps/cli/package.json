{
	"name": "@relayapi/cli",
	"version": "0.1.0",
	"description": "Official command-line client for RelayAPI",
	"license": "Apache-2.0",
	"type": "module",
	"bin": {
		"relay": "./dist/index.js"
	},
	"files": [
		"dist/**",
		"README.md"
	],
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "bun run src/index.ts",
		"build": "bun build src/index.ts --target=node --format=esm --packages=external --outfile=dist/index.js",
		"prepack": "bun run build",
		"test": "bun test",
		"test:package": "bun run build && node tests/package-smoke.mjs",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@clack/prompts": "^1.7.0",
		"@relayapi/sdk": "^0.23.0",
		"commander": "^15.0.0",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"typescript": "^7.0.2"
	}
}
