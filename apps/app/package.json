{
	"name": "@relayapi/app",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build && bun run prepare:deploy",
		"preview": "astro preview",
		"prepare:deploy": "bun ./scripts/prepare-wrangler-deploy.ts",
		"deploy": "bun run prepare:deploy && wrangler deploy --config dist/server/wrangler.json",
		"deploy:dry-run": "bun run prepare:deploy && wrangler deploy --config dist/server/wrangler.json --dry-run",
		"types": "wrangler types worker-configuration.d.ts --env-file /dev/null --env-interface AppWorkerEnv --include-runtime=false --config wrangler.jsonc --config ../api/wrangler.jsonc",
		"types:check": "wrangler types worker-configuration.d.ts --env-file /dev/null --env-interface AppWorkerEnv --include-runtime=false --check --config wrangler.jsonc --config ../api/wrangler.jsonc",
		"test": "bun test"
	},
	"dependencies": {
		"@astrojs/cloudflare": "catalog:",
		"@astrojs/react": "catalog:",
		"@better-auth/api-key": "catalog:",
		"@dagrejs/dagre": "catalog:",
		"@dicebear/core": "catalog:",
		"@dicebear/styles": "catalog:",
		"@dnd-kit/core": "catalog:",
		"@dnd-kit/sortable": "catalog:",
		"@dnd-kit/utilities": "catalog:",
		"@fontsource-variable/geist": "catalog:",
		"@fontsource-variable/geist-mono": "catalog:",
		"@radix-ui/react-accordion": "catalog:",
		"@radix-ui/react-navigation-menu": "catalog:",
		"@radix-ui/react-select": "catalog:",
		"@radix-ui/react-slot": "catalog:",
		"@react-email/components": "catalog:",
		"@react-email/render": "catalog:",
		"@react-three/fiber": "catalog:",
		"@react-three/postprocessing": "catalog:",
		"@relayapi/auth": "workspace:*",
		"@relayapi/config": "workspace:*",
		"@relayapi/db": "workspace:*",
		"@relayapi/sdk": "workspace:*",
		"@tailwindcss/vite": "catalog:",
		"@tanstack/react-table": "catalog:",
		"@tsparticles/engine": "catalog:",
		"@tsparticles/react": "catalog:",
		"@tsparticles/slim": "catalog:",
		"astro": "catalog:",
		"better-auth": "catalog:",
		"class-variance-authority": "catalog:",
		"clsx": "catalog:",
		"date-fns": "catalog:",
		"lucide-react": "catalog:",
