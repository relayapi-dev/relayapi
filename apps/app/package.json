		"reactflow": "catalog:",
		"simple-icons": "catalog:",
		"svg-dotted-map": "catalog:",
		"tailwind-merge": "catalog:",
		"three": "catalog:"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/three": "catalog:",
		"tailwindcss": "catalog:",
		"tw-animate-css": "catalog:",
		"typescript": "catalog:",
		"wrangler": "catalog:"
	}
}
