---
import Container from "./Container.astro";
import { productProofs } from "./data";
---

<!-- Product facts replace the original fictional placeholder testimonials. -->
<section class="bg-[#f7f7f4] text-[#26251e]">
	<Container class="py-[clamp(3.5rem,8vw,4.25rem)]">
		<h2
			data-reveal
			class="mx-auto text-balance text-center text-[clamp(1.875rem,3.4vw,2.375rem)] font-normal leading-[1.2] tracking-[-0.02em] text-[#26251e]"
		>
			What ships today.
		</h2>

		<div
			data-reveal
			class="mt-14 grid grid-cols-1 items-stretch gap-[0.625rem] md:mt-20 md:grid-cols-2 lg:grid-cols-3"
		>
			{
				productProofs.map((proof) => (
					<div class="flex h-full min-h-[11.25rem] flex-col rounded-[0.25rem] bg-[#f2f1ed] px-[1.125rem] pt-4 pb-[1.125rem]">
						<span class="w-fit rounded-full bg-[#e4e1d9] px-2.5 py-1 text-[0.6875rem] font-semibold uppercase tracking-[0.08em] text-[#6e6a62]">
							{proof.status}
						</span>
						<h3 class="mt-5 text-[1rem] font-semibold leading-[1.4] text-[#26251e]">
							{proof.title}
						</h3>
						<p class="mt-3 text-[0.9375rem] leading-[1.55] text-[#26251e]/70">
							{proof.detail}
						</p>
					</div>
				))
			}
		</div>
	</Container>
</section>
