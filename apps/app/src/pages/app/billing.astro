---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { BillingRouteApp } from "../../components/dashboard/route-apps/billing-route-app";
import { getDashboardRouteContext } from "../../lib/dashboard-page";

const dashboard = getDashboardRouteContext(Astro.locals, Astro.url);
if (import.meta.env.PUBLIC_DEPLOYMENT_MODE === "self_hosted") {
	return Astro.redirect("/app/usage");
}
---

<DashboardLayout>
	<BillingRouteApp
		client:load
		currentPage="billing"
		requiresApiKey={false}
		{...dashboard}
	/>
</DashboardLayout>
