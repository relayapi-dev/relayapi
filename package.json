{
	"name": "relayapi",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*",
			"packages/integrations/*"
		],
		"catalog": {
			"@astrojs/cloudflare": "^14.1.2",
			"@astrojs/react": "^6.0.1",
			"@better-auth/api-key": "^1.6.23",
			"@clack/prompts": "^1.7.0",
			"@cloudflare/vitest-pool-workers": "^0.18.4",
			"@dagrejs/dagre": "^3.0.0",
			"@dicebear/core": "^10.3.0",
			"@dicebear/styles": "^10.2.0",
			"@dnd-kit/core": "^6.3.1",
			"@dnd-kit/sortable": "^10.0.0",
			"@dnd-kit/utilities": "^3.2.2",
			"@fontsource-variable/geist": "^5.2.9",
			"@fontsource-variable/geist-mono": "^5.2.8",
			"@hono/swagger-ui": "^0.6.1",
			"@hono/zod-openapi": "^1.4.0",
			"@opennextjs/cloudflare": "^1.20.1",
			"@radix-ui/react-accordion": "^1.2.16",
			"@radix-ui/react-navigation-menu": "^1.2.18",
			"@radix-ui/react-popover": "^1.1.19",
			"@radix-ui/react-select": "^2.3.3",
			"@radix-ui/react-slot": "^1.3.0",
			"@react-email/components": "^1.0.12",
			"@react-email/render": "^2.1.0",
			"@react-three/fiber": "^9.6.1",
			"@react-three/postprocessing": "^3.0.4",
			"@tailwindcss/postcss": "^4.3.2",
			"@tailwindcss/vite": "^4.3.2",
			"@tanstack/react-table": "^8.21.3",
			"@tsparticles/engine": "^4.3.2",
			"@tsparticles/react": "^4.3.2",
			"@tsparticles/slim": "^4.3.2",
			"@types/bun": "^1.3.14",
			"@types/mdx": "^2.0.14",
			"@types/node": "^26.1.1",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3",
			"@types/three": "^0.185.1",
			"astro": "^7.0.7",
			"aws4fetch": "^1.0.20",
			"better-auth": "^1.6.23",
			"class-variance-authority": "^0.7.1",
			"clsx": "^2.1.1",
			"commander": "^15.0.0",
			"date-fns": "^4.4.0",
			"dotenv-cli": "^11.0.0",
			"drizzle-kit": "^0.31.10",
			"drizzle-orm": "^0.45.2",
			"fast-xml-parser": "^5.10.0",
			"fumadocs-core": "^16.11.3",
			"fumadocs-mdx": "^15.1.0",
			"fumadocs-openapi": "^11.1.1",
			"fumadocs-ui": "^16.11.3",
			"hono": "^4.12.29",
			"json-schema-typed": "^8.0.2",
			"lucide-react": "^1.24.0",
			"motion": "^12.42.2",
			"next": "~16.2.10",
			"picocolors": "^1.1.1",
			"postgres": "^3.4.9",
			"postprocessing": "6.39.2",
			"radix-ui": "^1.6.2",
			"react": "^19.2.7",
			"react-dom": "^19.2.7",
			"reactflow": "^11.11.4",
			"resend": "^6.17.2",
			"shiki": "^4.3.1",
			"simple-icons": "^16.26.0",
			"stripe": "^22.3.1",
			"svg-dotted-map": "^2.1.0",
			"tailwind-merge": "^3.6.0",
			"tailwindcss": "^4.3.2",
			"three": "^0.185.1",
			"tw-animate-css": "^1.4.0",
			"typescript": "^6.0.3",
			"vitest": "^4.1.10",
			"wrangler": "^4.110.0",
			"zod": "^4.4.3"
		}
	},
	"scripts": {
		"dev:api": "bun run db:with-tunnel -- bun run --cwd apps/api dev",
		"dev:app": "cd apps/app && bun run dev",
		"dev:docs": "cd apps/docs && bun run dev",
		"dev:cli": "cd apps/cli && bun run dev",
		"typecheck": "bun run typecheck:db && bun run typecheck:auth && bun run build:sdk && bun run typecheck:mcp && bun run typecheck:api && bun run typecheck:app && bun run typecheck:docs && bun run typecheck:cli && bun run typecheck:n8n && bun run typecheck:zapier",
		"typecheck:db": "cd packages/db && tsc --noEmit",
		"typecheck:auth": "cd packages/auth && tsc --noEmit",
		"build:sdk": "cd packages/sdk && tsc -p tsconfig.build.json",
		"typecheck:mcp": "cd packages/mcp && tsc --noEmit",
		"typecheck:api": "cd apps/api && bun run types && tsc --noEmit",
		"typecheck:app": "cd apps/app && tsc --noEmit",
		"typecheck:docs": "cd apps/docs && tsc --noEmit",
		"typecheck:cli": "cd apps/cli && tsc --noEmit",
		"typecheck:n8n": "cd packages/integrations/n8n-node && tsc --noEmit",
		"typecheck:zapier": "cd packages/integrations/zapier-app && tsc --noEmit",
		"db:generate": "bun --env-file=apps/api/.dev.vars run --cwd packages/db generate",
		"db:with-tunnel": "bun --env-file=apps/api/.dev.vars run scripts/with-db-tunnel.ts",
		"db:studio": "bun run db:with-tunnel -- bun run --cwd packages/db studio",
		"db:migrate": "bun run db:with-tunnel -- bun run --cwd packages/db migrate",
		"db:verify": "bun run db:with-tunnel -- bun run --cwd packages/db verify:migrations",
		"db:verify-schema-contracts": "cd packages/db && bun run verify:schema-contracts",
		"db:migration-policy": "cd packages/db && bun run migration:policy:check",
		"db:migration-append-only": "cd packages/db && bun run migration:append-only",
		"db:migration-manifest": "cd packages/db && bun run migration:manifest:check",
		"db:migration-history": "bun run db:with-tunnel -- bun run --cwd packages/db migration:history",
		"db:migration-history:current": "bun run db:with-tunnel -- bun run --cwd packages/db migration:history:current",
		"deps:sync": "bun run scripts/sync-catalog.ts",
		"deps:upgrade": "bun run scripts/upgrade-catalog.ts",
		"packages:update": "bun run scripts/sync-catalog.ts && bun run scripts/upgrade-catalog.ts",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3"
	},
	"patchedDependencies": {
		"undici@7.24.4": "patches/undici@7.24.4.patch"
	},
	"overrides": {
		"kysely": "0.28.17"
	}
}
