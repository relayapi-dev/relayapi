	"scripts": {
		"dev:api": "bun run db:with-tunnel -- bun run --cwd apps/api dev",
		"dev:app": "cd apps/app && bun run dev",
		"dev:docs": "cd apps/docs && bun run dev",
		"dev:cli": "cd apps/cli && bun run dev",
		"typecheck": "bun run typecheck:db && bun run typecheck:auth && bun run build:sdk && bun run typecheck:mcp && bun run typecheck:api && bun run typecheck:app && bun run typecheck:docs && bun run typecheck:cli && bun run typecheck:self-host && bun run typecheck:n8n && bun run typecheck:zapier",
		"typecheck:db": "cd packages/db && tsc --noEmit",
		"typecheck:auth": "cd packages/auth && tsc --noEmit",
		"build:sdk": "bun run --cwd packages/sdk build",
		"typecheck:mcp": "cd packages/mcp && tsc --noEmit",
		"typecheck:api": "cd apps/api && bun run types && tsc --noEmit",
		"typecheck:app": "cd apps/app && tsc --noEmit",
		"typecheck:docs": "cd apps/docs && tsc --noEmit",
		"typecheck:cli": "cd apps/cli && tsc --noEmit",
		"typecheck:self-host": "cd packages/self-host && tsc --noEmit",
		"typecheck:n8n": "cd packages/integrations/n8n-node && tsc --noEmit",
		"typecheck:zapier": "cd packages/integrations/zapier-app && tsc --noEmit",
		"db:generate": "bun --env-file=apps/api/.dev.vars run --cwd packages/db generate",
		"db:with-tunnel": "bun --env-file=apps/api/.dev.vars run scripts/with-db-tunnel.ts",
		"db:studio": "bun run db:with-tunnel -- bun run --cwd packages/db studio",
		"db:migrate": "bun run db:with-tunnel -- bun run --cwd packages/db migrate",
		"db:verify": "bun run db:with-tunnel -- bun run --cwd packages/db verify:migrations",
		"db:verify-schema-contracts": "cd packages/db && bun run verify:schema-contracts",
		"db:migration-policy": "cd packages/db && bun run migration:policy:check",
		"db:migration-append-only": "cd packages/db && bun run migration:append-only",
		"db:migration-manifest": "cd packages/db && bun run migration:manifest:check",
		"db:migration-history": "bun run db:with-tunnel -- bun run --cwd packages/db migration:history",
		"db:migration-history:current": "bun run db:with-tunnel -- bun run --cwd packages/db migration:history:current",
		"deps:sync": "bun run scripts/sync-catalog.ts",
		"deps:upgrade": "bun run scripts/upgrade-catalog.ts",
		"packages:update": "bun run scripts/sync-catalog.ts && bun run scripts/upgrade-catalog.ts",
		"secrets:init": "bun run scripts/secrets.ts init",
		"secrets:encrypt": "bun run scripts/secrets.ts encrypt",
		"secrets:decrypt": "bun run scripts/secrets.ts decrypt",
		"secrets:check": "bun run scripts/secrets.ts check",
		"secrets:validate": "bun run scripts/secrets.ts validate",
		"secrets:armor": "bun run scripts/secrets.ts armor",
		"secrets:native": "bun run scripts/secrets.ts native",
		"secrets:cf:sync": "bun run scripts/secrets.ts cf-sync",
		"secrets:cf:deploy": "bun run scripts/secrets.ts cf-deploy",
		"secrets:cf:preflight": "bun run scripts/secrets.ts cf-preflight",
		"secrets:cf:verify": "bun run scripts/secrets.ts cf-verify",
		"test:secrets": "bun test scripts/secrets.test.ts",
		"test:edge-policy": "bun test scripts/verify-production-edge.test.ts scripts/verify-cloudflare-worker-deployment.test.ts",
		"test:cloudflare-secret-policy": "bun test scripts/verify-cloudflare-worker-secrets.test.ts",
		"test:cloudflare-skill-safety": "bun test scripts/cloudflare-skill-safety.test.ts",
		"edge:verify-production": "bun run scripts/verify-production-edge.ts",
		"cloudflare:verify-worker-secrets": "bun run scripts/verify-cloudflare-worker-secrets.ts",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@dotenvx/dotenvx": "^2.14.0",
		"@dotenvx/dotenvx-armor": "^0.56.1"
	},
	"overrides": {
		"@babel/core": "7.29.7",
		"@hono/node-server": "2.1.0",
		"@sigstore/core": "3.2.1",
		"adm-zip": "0.6.0",
		"body-parser": "2.3.0",
		"diff": "8.0.4",
