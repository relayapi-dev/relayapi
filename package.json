		"svgo": "4.0.2",
		"tar": "7.5.22",
		"tmp": "0.2.7",
		"undici": "7.29.0",
		"uuid": "11.1.1",
		"ws": "8.21.3",
		"yeoman-environment": "6.1.0"
	}
